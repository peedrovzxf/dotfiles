{
  "output": ["*"],
  "layer": "top",
  "position": "bottom",
  "height": 36,
  "margin-bottom": 0,
  "spacing": 0,
  "modules-left": ["hyprland/workspaces"],
  "modules-right": ["tray", "battery", "network", "pulseaudio", "clock"],

  "battery": {
    "format": "{capacity}%  ",
    "format-charging": "  {capacity}%+",
    "format-full": "  full",
    "tooltip": false
  },
  "tray": {
    "spacing": 6,
    "icon-size": 12
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "sort-by-number": true
  },

  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "{bandwidthDownBytes}",
    "format-disconnected": "offline",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "{essid} ({signalStrength}%) {ipaddr}\n   {bandwidthUpBytes} |    {bandwidthDownBytes}"
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  muted",
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "clock": {
    "format": "{:%H:%M:%S}",
    "interval": 1,
    "tooltip": false
  }
}
